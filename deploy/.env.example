# Скопировать в .env и заполнить. Файл .env в репозиторий не попадает.
#
# ВАЖНО: пароли и ключи придумывать не в голове, а генерировать. На сервере:
#     openssl rand -base64 32

# --- Домен и сертификат -------------------------------------------------------
# Домен должен уже указывать А-записью на IP этого сервера, иначе Caddy
# не сможет получить сертификат и n8n не откроется.
#
# Панель управления живёт на поддомене, а не на основном домене: на основном
# будет сайт для клиентов, и смешивать их нельзя.
N8N_HOST=n8n.kargintech.ru
LETSENCRYPT_EMAIL=mihailkargin5663@gmail.com

# --- База данных --------------------------------------------------------------
DB_NAME=n8n
DB_USER=n8n
DB_PASSWORD=

# --- Ключ шифрования доступов -------------------------------------------------
# Этим ключом n8n шифрует сохранённые доступы: токен Telegram, ключи Google,
# пароли почты. ПОТЕРЯ КЛЮЧА = все доступы придётся заводить заново.
# Сохранить в менеджере паролей сразу после генерации.
N8N_ENCRYPTION_KEY=

# --- Запасной адрес для сообщений о сбоях -------------------------------------
# Адреса чатов лежат в файле клиента (/data/clients/<имя>.json). Но если файл
# пропал или в нём ошибка — сообщить об этом будет НЕКУДА, и поломка настроек
# превратится в полное молчание: клиент не получает тендеров, владелец не
# получает причины.
#
# Поэтому у владельца есть адрес, не зависящий от файлов клиентов. Узнать свой:
# написать боту @userinfobot в Telegram, он ответит числом.
OWNER_CHAT_ID=

# --- Модель (поиск поставщиков) -----------------------------------------------
# Обе строки можно оставить пустыми: тогда поиск поставщиков пропускается, и
# расчёт идёт только по ценам из документов закупки. Пропуск ВИДЕН в ответе
# /health — чтобы это не выяснялось по неполной смете у клиента.
#
# Ключ Anthropic. Карты российских банков Anthropic не принимает, поэтому
# получение ключа — отдельная задача, см. БИЗНЕС-ПЛАН.md, раздел 13.
ANTHROPIC_API_KEY=

# Зарубежный посредник: Anthropic не отвечает на российские адреса.
# Вид: http://пользователь:пароль@ABROAD_IP:8888
#
# ДЕЙСТВУЕТ ТОЛЬКО НА ВЫЗОВЫ МОДЕЛИ из контейнера app. Глобальные
# HTTP_PROXY/HTTPS_PROXY для контейнера app задавать НЕЛЬЗЯ: портал закупок
# увидит зарубежный адрес и перестанет отвечать вовсе.
CLAUDE_PROXY_URL=

# --- Доставка в Telegram --------------------------------------------------------
# Измерено 09.10.2026: api.telegram.org с российского сервера недоступен —
# соединение не устанавливается вовсе. Поэтому n8n ходит в Telegram через того
# же зарубежного посредника.
#
# Значение обычно совпадает с CLAUDE_PROXY_URL. Отдельная переменная нужна,
# чтобы доставку можно было отключить, не трогая путь к модели.
#
# Действует ТОЛЬКО на контейнер n8n, и только потому, что он на портал не ходит.
# На зарубежном сервере адрес должен быть разрешён в /etc/tinyproxy/allowed.txt.
TELEGRAM_PROXY_URL=

# --- Yandex Cloud (поиск поставщиков, 31.10.2026) ------------------------------
# Работает из России напрямую. Вписать: .\deploy\yandex-key.ps1 с компьютера
# владельца (ключ сервисного аккаунта, папка b1g0g13647pl65vthcoi).
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
# Пусто - aliceai-llm-flash.
YANDEX_MODEL=
# Пусто - сначала Claude, при отказе Яндекс; yandex - Яндекс основной.
SUPPLIER_SEARCH=

# Kimi Open Platform - контролируемое сравнение модели чтения страниц.
# Ключ создаётся отдельно от аккаунта Kimi Code; владелец вводит через deploy/kimi-key.ps1.
KIMI_API_KEY=
KIMI_MODEL=kimi-k2.8-preview

# --- Почта для запросов КП поставщикам ------------------------------------------
# Пустые - почта выключена, очередь запросов ждёт.
MAIL_USER=
MAIL_PASSWORD=
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=465
MAIL_IMAP_HOST=
MAIL_IMAP_PORT=993
MAIL_FROM_NAME=KarginTech

# --- Сайт ------------------------------------------------------------------------
# Оплата ЮKassa (КАК-РАБОТАТЬ.md, «Оплата ЮKassa»). Пустые - кнопка «Оставить заявку».
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# Имя бота без @.
TELEGRAM_BOT_USERNAME=
# Реквизиты для оферты; без LEGAL_READY=1 страницы «на согласовании».
LEGAL_NAME=
LEGAL_INN=
LEGAL_EMAIL=
LEGAL_READY=
# Вход через Google. Пустые - кнопки нет.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Пусто - site-d8ba393a05d4 (пример ленты до стартовой настройки).
SITE_DEMO_CLIENT=
# 1 - регистрация без кода приглашения (после РКН и реквизитов в оферте).
REGISTRATION_OPEN=

# --- Копия вне основного сервера (02.11.2026) -------------------------------------
# Без этих двух строк ночная копия лежит только на этом сервере, и самопроверка
# каждый день шлёт владельцу сигнал. Настройка - КАК-РАБОТАТЬ.md, «Копия данных
# сервера вне основного сервера».
# С 11.11.2026 Сингапур не используется. Для внешней копии нужно отдельное
# хранилище; адрес владелец задаёт после его выбора. Пусто - копия только локальная,
# самопроверка будет сигнализировать, что внешней копии нет.
OFFSITE_HOST=
OFFSITE_CERT=
