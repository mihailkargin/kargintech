# Образ n8n с тем, что нужно этому проекту:
#   — корневые сертификаты НУЦ Минцифры (без них портал не отвечает);
#   — модули логики из src/, чтобы Code-ноды подключали их, а не копипастили.
#
# Конвертера старых форматов Microsoft здесь НЕТ, и это не упущение.
#
# ПОЧЕМУ (установлено 01.10.2026 на сервере, не предположение):
# базовый образ n8n собран как Docker Hardened Image. Из такого образа
# менеджер пакетов вырезан намеренно — ни apk, ни apt внутри нет:
#     NAME="Docker Hardened Images (Alpine)"  VERSION_ID=3.24
#     ни одного менеджера пакетов не найдено
# Первая версия этого файла пыталась поставить LibreOffice через apk и упала
# с кодом 127 («команда не найдена»). Это не опечатка в именах пакетов —
# доустановить в такой образ нельзя ничего и никак.
#
# Обходить защиту мы не стали: именно в этом контейнере живут доступы
# клиентов, и ослаблять его ради конвертера неправильно. Конвертер вынесен
# в отдельный контейнер — deploy/converter/, вызывается по сети внутри
# docker-сети и наружу не смотрит. Побочная выгода: падение или зависание
# LibreOffice больше не может уронить n8n.
#
# Почему не «поставить всё руками на сервере»: ручная установка не
# воспроизводится. Через полгода при переезде или после сбоя никто не вспомнит,
# что именно ставилось и в каком порядке, а отсутствие одного сертификата
# выглядит как «портал перестал отвечать» — то есть как тихий отказ.

FROM n8nio/n8n:latest

# --- Корневые сертификаты НУЦ Минцифры ---------------------------------------
# Сертификат портала закупок выпущен «Russian Trusted Sub CA». В стандартном
# наборе доверенных корней его нет, и любой запрос падает с UntrustedRoot.
#
# Обычный путь — положить .crt в /usr/local/share/ca-certificates и вызвать
# update-ca-certificates — здесь закрыт: в hardened-образе этой утилиты нет.
# Поэтому оба сертификата склеены в один файл и подставлены Node через
# NODE_EXTRA_CA_CERTS. Node добавляет их К встроенным доверенным корням,
# а не вместо них, так что остальной интернет продолжает проверяться как было.
#
# Файл собирает setup-server.sh из скачанных и проверенных сертификатов.
# Он НЕ скачивается во время сборки: иначе недоступность стороннего сайта
# ронял бы сборку целиком, а подмена файла осталась бы незамеченной.
COPY --chown=1000:1000 deploy/certs/russian-ca-bundle.crt \
     /opt/certs/russian-ca-bundle.crt

# --- Модули логики -------------------------------------------------------------
# Лежат отдельной папкой, чтобы Code-нода делала require('/opt/tender/parser'),
# а не хранила копию кода внутри воркфлоу. Копия в воркфлоу означает, что
# исправление ловушки в парсере надо руками разнести по всем нодам.
COPY --chown=1000:1000 src/ /opt/tender/

# Node берёт доверенные корни не из системного хранилища, а из своего набора.
# Без этой переменной сертификат НУЦ лежит в образе, а запросы из Code-нод
# всё равно падают — и разбираться в этом потом очень неприятно.
ENV NODE_EXTRA_CA_CERTS=/opt/certs/russian-ca-bundle.crt

# Адрес конвертера внутри docker-сети. Воркфлоу берёт его отсюда, а не
# прописывает в нодах: иначе при переименовании сервиса придётся править
# каждую ноду, и забытая нода тихо перестанет конвертировать.
ENV CONVERTER_URL=http://converter:3000

# Разрешаем Code-нодам подключать встроенные модули и наши файлы.
#
# NODE_FUNCTION_ALLOW_EXTERNAL=* — это ослабление защиты, названное вслух:
# кто получит доступ в панель n8n, сможет запустить на сервере любой код.
# Отсюда требование: пароль от панели сильный, и клиентам панель не выдаётся
# никогда — клиент работает с Telegram и файлом Excel.
#
# https и http нужны Code-нодам для запросов к порталу и к конвертеру.
# Глобального fetch в песочнице n8n НЕТ — проверено на сервере 03.10.2026,
# нода падала с «fetch is not defined». AbortController там тоже отсутствует.
# Поэтому запросы делаются встроенными модулями: они есть всегда и ведут себя
# одинаково независимо от версии n8n.
#
# tls нужен, чтобы получить встроенный набор доверенных корней и добавить
# к нему сертификат НУЦ. Переменная NODE_EXTRA_CA_CERTS до песочницы Code-ноды
# НЕ доходит — проверено на сервере 03.10.2026, запрос к порталу падал
# с «self-signed certificate in certificate chain», хотя с самого сервера
# тот же адрес отвечает кодом 200. Значит код Code-нод исполняется в отдельном
# процессе со своим окружением, и корни надо передавать в запрос явно.
ENV NODE_FUNCTION_ALLOW_BUILTIN=zlib,crypto,buffer,path,fs,https,http,url,tls
ENV NODE_FUNCTION_ALLOW_EXTERNAL=*
